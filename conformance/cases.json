{
  "kit": "conformance/1",
  "about": "Planted failures and known-good records for contract version 1. Each case starts from a file in the worked example, applies 'set' and 'remove' (dot paths; numbers index lists) and expects exactly the listed rule IDs to refuse it. 'replace' swaps text in a handoff. Paths are relative to the kit root.",
  "project": "examples/walkthrough/project/.engineering-kit/project.json",
  "project_root": "examples/walkthrough/project",
  "tasks": [
    {"name": "every worked stage passes: proposed", "task": "examples/walkthrough/stages/01-proposed.json", "expect": []},
    {"name": "every worked stage passes: accepted", "task": "examples/walkthrough/stages/02-accepted.json", "expect": []},
    {"name": "every worked stage passes: candidate", "task": "examples/walkthrough/stages/03-candidate.json", "expect": []},
    {"name": "every worked stage passes: reviewed", "task": "examples/walkthrough/stages/04-reviewed.json", "expect": []},
    {"name": "every worked stage passes: released", "task": "examples/walkthrough/stages/05-released.json", "expect": []},
    {"name": "every worked stage passes: verified", "task": "examples/walkthrough/stages/06-verified.json", "expect": []},
    {"name": "every worked stage passes: closed", "task": "examples/walkthrough/stages/07-closed.json", "expect": []},
    {"name": "a recorded exception lets the docs profile skip review", "task": "examples/walkthrough/stages/04-reviewed.json",
     "set": {"profile": "docs", "reviews": []}, "expect": []},

    {"name": "missing acceptance examples", "task": "examples/walkthrough/stages/02-accepted.json",
     "set": {"requirement.acceptance": []}, "expect": ["ACCEPT"]},
    {"name": "acceptance boundary the project does not define", "task": "examples/walkthrough/stages/02-accepted.json",
     "set": {"requirement.acceptance_boundary": "production"}, "expect": ["ACCEPT"]},
    {"name": "no decision owner", "task": "examples/walkthrough/stages/02-accepted.json",
     "remove": ["requirement.decision_owner"], "expect": ["ACCEPT"]},
    {"name": "unknown delivery profile", "task": "examples/walkthrough/stages/02-accepted.json",
     "set": {"profile": "hotfix"}, "expect": ["PROFILE"]},
    {"name": "not applicable without a reason", "task": "examples/walkthrough/stages/04-reviewed.json",
     "set": {"not_applicable": [{"check": "lint"}]}, "expect": ["PROFILE"]},
    {"name": "candidate state without a revision", "task": "examples/walkthrough/stages/03-candidate.json",
     "remove": ["candidate.revision"], "expect": ["CANDIDATE"]},
    {"name": "candidate state without its base", "task": "examples/walkthrough/stages/03-candidate.json",
     "remove": ["candidate.base"], "expect": ["CANDIDATE"]},
    {"name": "a proposed task may have no author yet", "task": "examples/walkthrough/stages/01-proposed.json",
     "remove": ["author"], "expect": []},
    {"name": "an accepted task names its author", "task": "examples/walkthrough/stages/02-accepted.json",
     "remove": ["author"], "expect": ["FORMAT"]},
    {"name": "a candidate whose required checks never ran", "task": "examples/walkthrough/stages/03-candidate.json",
     "set": {"checks": []}, "expect": ["CHECKS"]},
    {"name": "a check without the revision it ran on", "task": "examples/walkthrough/stages/03-candidate.json",
     "remove": ["checks.0.revision"], "expect": ["CHECKS", "FORMAT"]},
    {"name": "effects that are not a list are refused, not ignored", "task": "examples/walkthrough/stages/05-released.json",
     "set": {"effects": {"kind": "publish-package", "target": "1.4.1"}}, "expect": ["EFFECTS"]},

    {"name": "stale candidate evidence after a new revision", "task": "examples/walkthrough/stages/04-reviewed.json",
     "set": {"candidate.revision": "d4e5f60"}, "expect": ["CANDIDATE"]},
    {"name": "skipped required check", "task": "examples/walkthrough/stages/04-reviewed.json",
     "set": {"checks.3.result": "skipped"}, "expect": ["CHECKS"]},
    {"name": "failed required check", "task": "examples/walkthrough/stages/04-reviewed.json",
     "set": {"checks.2.result": "fail"}, "expect": ["CHECKS"]},
    {"name": "unknown required check", "task": "examples/walkthrough/stages/04-reviewed.json",
     "set": {"checks.2.result": "unknown"}, "expect": ["UNKNOWN"]},
    {"name": "missing required check", "task": "examples/walkthrough/stages/04-reviewed.json",
     "remove": ["checks.3", "checks.1"], "expect": ["CHECKS"]},
    {"name": "defect without a reproduction", "task": "examples/walkthrough/stages/04-reviewed.json",
     "remove": ["reproduction"], "expect": ["REPRODUCE"]},
    {"name": "reproduction that never failed", "task": "examples/walkthrough/stages/04-reviewed.json",
     "set": {"reproduction.base_result": "pass"}, "expect": ["REPRODUCE"]},
    {"name": "reproduction on a revision other than the candidate's base", "task": "examples/walkthrough/stages/04-reviewed.json",
     "set": {"reproduction.base": "0000000"}, "expect": ["REPRODUCE"]},

    {"name": "unresolved blocking review finding", "task": "examples/walkthrough/stages/04-reviewed.json",
     "set": {"reviews.1.findings.0.blocking": true}, "expect": ["REVIEW"]},
    {"name": "author reviewed their own work", "task": "examples/walkthrough/stages/04-reviewed.json",
     "set": {"reviews.1.reviewer": "agent:session-a"}, "expect": ["REVIEW"]},
    {"name": "the author under a differently written name", "task": "examples/walkthrough/stages/04-reviewed.json",
     "set": {"reviews.1.reviewer": " Agent:Session-A"}, "expect": ["REVIEW"]},
    {"name": "no approving review", "task": "examples/walkthrough/stages/04-reviewed.json",
     "set": {"reviews.1.verdict": "changes"}, "expect": ["REVIEW"]},

    {"name": "effect authorized by a role the policy does not allow", "task": "examples/walkthrough/stages/05-released.json",
     "set": {"effects.0.authorized_by": "contributor"}, "expect": ["EFFECTS"]},
    {"name": "effect kind outside the authority policy", "task": "examples/walkthrough/stages/05-released.json",
     "set": {"effects.0.kind": "delete-customer-data"}, "expect": ["EFFECTS"]},
    {"name": "two-way effect without a rollback", "task": "examples/walkthrough/stages/05-released.json",
     "remove": ["effects.0.rollback"], "expect": ["EFFECTS"]},
    {"name": "one-way effect that does not say what is lost", "task": "examples/walkthrough/stages/05-released.json",
     "set": {"effects.0.door": "one-way"}, "expect": ["EFFECTS"]},
    {"name": "an unauthorized effect is refused even after the task stopped", "task": "examples/walkthrough/stages/05-released.json",
     "set": {"state": "cancelled", "effects.0.authorization": ""}, "expect": ["EFFECTS"]},
    {"name": "release built from another revision", "task": "examples/walkthrough/stages/05-released.json",
     "set": {"release.source": "a91c3e0"}, "expect": ["CANDIDATE"]},
    {"name": "release without a rollback target", "task": "examples/walkthrough/stages/05-released.json",
     "remove": ["release.rollback"], "expect": ["RELEASE"]},
    {"name": "release in a profile without one", "task": "examples/walkthrough/stages/05-released.json",
     "set": {"profile": "docs"}, "expect": ["PROFILE"]},

    {"name": "verified only from local tests", "task": "examples/walkthrough/stages/06-verified.json",
     "set": {"verification.1.boundary": "local"}, "expect": ["BOUNDARY"]},
    {"name": "verification of another revision", "task": "examples/walkthrough/stages/06-verified.json",
     "set": {"verification.1.revision": "a91c3e0"}, "expect": ["CANDIDATE"]},
    {"name": "verification of the merge that landed the candidate", "task": "examples/walkthrough/stages/06-verified.json",
     "set": {"candidate.integrated": [{"revision": "e0d1f22", "evidence": "kit.py integrated c2f9e41 e0d1f22 found no difference"}],
             "verification.1.revision": "e0d1f22"}, "expect": []},
    {"name": "an integrated revision without evidence", "task": "examples/walkthrough/stages/06-verified.json",
     "set": {"candidate.integrated": [{"revision": "e0d1f22"}], "verification.1.revision": "e0d1f22"},
     "expect": ["CANDIDATE"]},
    {"name": "unknown result at the acceptance boundary", "task": "examples/walkthrough/stages/06-verified.json",
     "set": {"verification.1.result": "unknown"}, "expect": ["BOUNDARY", "UNKNOWN"]},
    {"name": "a later pass settles an earlier unknown", "task": "examples/walkthrough/stages/06-verified.json",
     "set": {"verification": [
       {"boundary": "published", "revision": "c2f9e41", "result": "unknown", "evidence": "The index timed out"},
       {"boundary": "published", "revision": "c2f9e41", "result": "pass", "evidence": "Installed on retry"}]}, "expect": []},
    {"name": "uncertain effect in a verified task", "task": "examples/walkthrough/stages/06-verified.json",
     "set": {"effects.0.status": "uncertain"}, "expect": ["UNKNOWN"]},
    {"name": "closed without documentation", "task": "examples/walkthrough/stages/07-closed.json",
     "remove": ["documentation"], "expect": ["DOCS"]}
  ],
  "projects": [
    {"name": "the worked project passes", "expect": []},
    {"name": "exception to a fixed rule", "set": {"exceptions.1": {"rule": "CHECKS", "scope": "project", "reason": "Tests are slow", "approved_by": "owner", "date": "2026-10-20"}}, "expect": ["CHECKS"]},
    {"name": "profile skips review without an exception", "remove": ["exceptions.0"], "expect": ["REVIEW"]},
    {"name": "exception approved by an unknown role", "set": {"exceptions.0.approved_by": "intern"}, "expect": ["REVIEW"]},
    {"name": "project rule without an enforcement label", "set": {"rules.1.enforced": "usually"}, "expect": ["ENFORCEMENT"]},
    {"name": "checked project rule that names no check", "remove": ["rules.0.by"], "expect": ["ENFORCEMENT"]},
    {"name": "effect kind allowed to an undefined role", "set": {"authority.effects.publish-package": ["maintainer"]}, "expect": ["EFFECTS"]},
    {"name": "instruction file that does not exist", "set": {"instructions.clients.any-agent": ["MISSING.md"]}, "expect": ["FORMAT"]},
    {"name": "a boundary meaning for an undefined boundary", "set": {"boundary_meaning": {"production": "the live site"}}, "expect": ["FORMAT"]},
    {"name": "a template placeholder left in the configuration", "set": {"scope": "replace with what the project is"}, "expect": ["FORMAT"]}
  ],
  "contributions": [
    {"name": "a contribution with provenance and rights passes", "file": "examples/contribution.json", "expect": []},
    {"name": "unknown rights stay out", "file": "examples/contribution.json", "set": {"rights": "unknown"}, "expect": ["LESSON"]},
    {"name": "employer material without clearance", "file": "examples/contribution.json", "set": {"rights": "employer"}, "expect": ["LESSON"]},
    {"name": "a lesson without evidence", "file": "examples/contribution.json", "set": {"evidence": ""}, "expect": ["LESSON"]},
    {"name": "a lesson without its limits", "file": "examples/contribution.json", "remove": ["limits"], "expect": ["LESSON"]},
    {"name": "a lesson without its source revision", "file": "examples/contribution.json", "remove": ["source_revision"], "expect": ["LESSON"]},
    {"name": "a status that claims more than proposal or proven", "file": "examples/contribution.json", "set": {"status": "accepted"}, "expect": ["LESSON"]},
    {"name": "a third-party licence named by its identifier", "file": "examples/contribution.json", "set": {"rights": "licensed:MIT"}, "expect": []}
  ],
  "handoffs": [
    {"name": "the worked handoff passes", "file": "examples/walkthrough/project/.engineering-kit/handoffs/T-7.md", "expect": []},
    {"name": "no next action", "file": "examples/walkthrough/project/.engineering-kit/handoffs/T-7.md",
     "replace": [["- Add a test for example A2", "Add a test for example A2"]], "expect": ["HANDOFF"]},
    {"name": "two next actions", "file": "examples/walkthrough/project/.engineering-kit/handoffs/T-7.md",
     "replace": [["## Next action\n\n", "## Next action\n\n- Publish 1.4.1.\n"]], "expect": ["HANDOFF"]},
    {"name": "a section is missing", "file": "examples/walkthrough/project/.engineering-kit/handoffs/T-7.md",
     "replace": [["## Open gates", "## Gates"]], "expect": ["HANDOFF"]},
    {"name": "an empty section", "file": "examples/walkthrough/project/.engineering-kit/handoffs/T-7.md",
     "replace": [["- No review yet.\n- Example A2, a negative total, has no test.\n- Publishing 1.4.1 needs the owner's approval.\n", ""]], "expect": ["HANDOFF"]},
    {"name": "updated in the future", "file": "examples/walkthrough/project/.engineering-kit/handoffs/T-7.md",
     "replace": [["Updated: 2026-10-20T12:40:00+00:00", "Updated: 2999-01-01T00:00:00+00:00"]], "expect": ["HANDOFF"]},
    {"name": "handoff behind its task record", "file": "examples/walkthrough/project/.engineering-kit/handoffs/T-7.md",
     "replace": [["State: candidate", "State: in_progress"]], "expect": ["HANDOFF"]}
  ]
}
